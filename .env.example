# Required: Google Gemini API key (create at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Path to an Anki export (.apkg) or newline-separated word list (.txt)
# Words marked as reviewed here are used as context anchors and excluded from new vocabulary items.
# HOERBUCH_KNOWN=/app/known_words.apkg

# Optional: Directory where finished MP3, .apkg, and README files are copied on "Publish"
# HOERBUCH_PUBLISH=/app/published

# Optional: Web Studio bind host and port (defaults: 127.0.0.1 and 7865)
# Use 0.0.0.0 when running on a dedicated LAN/Docker machine.
# HOERBUCH_HOST=0.0.0.0
# HOERBUCH_PORT=7865
